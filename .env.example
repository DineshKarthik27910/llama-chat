# Network Configuration
# Set SERVER_HOST to your machine's local network IP address (e.g. <YOUR-LAN-IP> or localhost)
# Set SERVER_BIND_HOST to 0.0.0.0 so the server listens on all network interfaces
SERVER_HOST=<YOUR-LAN-IP>
SERVER_PORT=8000
SERVER_BIND_HOST=0.0.0.0

# LLM Provider Configuration
# Supported providers: ollama, openai, groq, openrouter, deepseek, or custom OpenAI-compatible endpoint
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://127.0.0.1:11434/v1

# Database Configuration
DATABASE_URL=sqlite:///./data/chat.db
